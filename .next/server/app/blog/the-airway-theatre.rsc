f:I[6861,["141","static/chunks/141-0dd37b0289a422b3.js","953","static/chunks/app/blog/%5Bslug%5D/page-2ce4131e95cc9064.js"],"default"]
10:I[1356,["141","static/chunks/141-0dd37b0289a422b3.js","953","static/chunks/app/blog/%5Bslug%5D/page-2ce4131e95cc9064.js"],"Image"]
4:[["$","$Lf",null,{"logoUrl":"$undefined"}],["$","main",null,{"children":[["$","div",null,{"className":"hero_hero__Cab7O","children":["$","$L10",null,{"className":"hero_image__q901w","src":"https://images.ctfassets.net/f0rnkukgphm9/6p59m9w8pKPclnn2FLKbAN/1354c8dc1d197eb673d990dccce242b0/Exterior_US_Bank_4015_S._Howell.jpg","alt":"The Airway Theatre","width":1180,"height":600,"priority":true,"sizes":"100vw"}]}],["$","div",null,{"className":"blog-post_container__pDN_0","children":[["$","span",null,{"className":"blog-post_meta__DveHe","children":["Milwaukee Garden District · ",["$","time",null,{"dateTime":"2024-09-17T00:00:00.000-05:00","children":"September 17, 2024"}]," – 3 minute read"]}],["$","div",null,{"className":"blog-post_article___xWEJ","children":[["$","div",null,{"className":"blog-post_body__4HKCm","children":[["$","p","0",{"children":["Located at 4001 S. Howell Avenue Milwaukee, Wisconsin"]}],["$","p","1",{"children":["Researched by Raven Blackwood, edited by Julia Rose"]}],["$","p","2",{"children":["\nToday if you travel to 4001 S. Howell in Milwaukee, you will find yourself at a US Bank location. However, over seven decades ago, the property was a beautiful movie theatre called The Airway Theatre, the last movie palace of its kind in Milwaukee. "]}],["$","div","3",{"style":{"margin":"20px 0","textAlign":"center"},"children":[["$","$L10",null,{"src":"https://images.ctfassets.net/f0rnkukgphm9/6p59m9w8pKPclnn2FLKbAN/1354c8dc1d197eb673d990dccce242b0/Exterior_US_Bank_4015_S._Howell.jpg?fm=webp&q=90&w=352","alt":"US Bank ","width":352,"height":498,"quality":90,"priority":false,"style":{"maxWidth":"100%","height":"auto","borderRadius":"8px","boxShadow":"0 2px 8px rgba(0,0,0,0.1)"},"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px"}],["$","p",null,{"style":{"fontSize":"0.9em","color":"#666","marginTop":"8px","fontStyle":"italic"},"children":"US Bank "}]]}],["$","p","4",{"children":["\nEugene Goderski founded the Airway Theatre was founded by in 1949. He first got the idea of having a theatre while he was an Army Airman stationed in the South Pacific. He fancied this idea due to his experience as a young projectionist for his father, Casimir, who owned a theatre called the Avenue Theatre back in 1919. Casimir purchased the theatre and re-opened it as the Aragon Theatre after remodeling. "]}],["$","p","5",{"children":["\nEugene worked for his father as a projectionist until the devastating event at Pearl Harbor on December 7, 1941, which also happened to be Eugene’s 36th birthday. That was when he decided at the age of thirty-six to enlist in the Army to fight in WWII."]}],["$","p","6",{"children":["\nWhen he returned from serving in the Army, Eugene commissioned Myles Belongia, a little-known architect, for the theatre’s design. Belongia was accustomed to designing churches but met the family at a trade show and they set their dreams in motion. "]}],["$","div","7",{"style":{"margin":"20px 0","textAlign":"center"},"children":[["$","$L10",null,{"src":"https://images.ctfassets.net/f0rnkukgphm9/1mOkvKfKpeuo884EvwZpw5/1da69b4d9cf446963e98abe723f1b104/Airway_Theatre_Front.jpg?fm=webp&q=90&w=600","alt":"Airway Theatre Front ","width":600,"height":461,"quality":90,"priority":false,"style":{"maxWidth":"100%","height":"auto","borderRadius":"8px","boxShadow":"0 2px 8px rgba(0,0,0,0.1)"},"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px"}],["$","p",null,{"style":{"fontSize":"0.9em","color":"#666","marginTop":"8px","fontStyle":"italic"},"children":"Airway Theatre Front "}]]}],["$","p","8",{"children":["\nThe Airway seated 625 people and was designed with an air hangar theme and the walls were decorated with historical photos of air flight. There were nine murals - one depicted two birds in flight beside the stage, another, a man flying a kite. There was a mural of a hot air balloon and the Wright Brothers “Kitty Hawk”, a helicopter, P-38 military plane, and the Flying Wing which was an aircraft sensation at the time. The theatre also had an innovative marquee that was a new modular type. The façade of a one-story entry was composed of “Los Rancheros” brick from the West, crab orchard stone from the Cumberland Mountains and Lannon stone, a limestone from Lannon, Wisconsin. "]}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18"]}],"$L19","$L1a"]}]]}]]}],"$L1b"]
1c:I[2619,["141","static/chunks/141-0dd37b0289a422b3.js","953","static/chunks/app/blog/%5Bslug%5D/page-2ce4131e95cc9064.js"],""]
11:["$","p","9",{"children":["\nThe grand opening was January 18,1949 and the first film shown was “On Our Merry Way” starring Henry Fonda, James Stewart, Paulette Goddard, Burgess Meredith, Fred MacMurray and Dorothy Lamour. Each ticket cost only 50 cents per person. "]}]
12:["$","div","10",{"style":{"margin":"20px 0","textAlign":"center"},"children":[["$","$L10",null,{"src":"https://images.ctfassets.net/f0rnkukgphm9/6bNXBuEzTB6jVtSwc3YiK/a66e5a738cb4e00b1f417b3eb8f43727/Airway_Theatre_Lobby.jpg?fm=webp&q=90&w=640","alt":"Airway Theatre Lobby ","width":640,"height":519,"quality":90,"priority":false,"style":{"maxWidth":"100%","height":"auto","borderRadius":"8px","boxShadow":"0 2px 8px rgba(0,0,0,0.1)"},"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px"}],["$","p",null,{"style":{"fontSize":"0.9em","color":"#666","marginTop":"8px","fontStyle":"italic"},"children":"Airway Theatre Lobby "}]]}]
13:["$","p","11",{"children":["\nUnfortunately, the theatre struggled because it was not allowed to show the new movies because it was not a studio-owned theatre. Studio-owned theatres were given first rights to show the brand-new, sought-after movies. "]}]
14:["$","p","12",{"children":["\nEugene and his staff tried many different gimmicks to draw people in, including free dinnerware, raffle prizes and talent shows. Another issue that kept people from attending his theatre was the popularity of television. People were simply attending movies less than they used to. "]}]
15:["$","div","13",{"style":{"margin":"20px 0","textAlign":"center"},"children":[["$","$L10",null,{"src":"https://images.ctfassets.net/f0rnkukgphm9/6nhZgDihO33AGEom8Ku1VH/4bf13a636ad13ef856b8b886caca05b2/Airway_Seating_and_Screen.jpg?fm=webp&q=90&w=640","alt":"Airway Seating and screen","width":640,"height":519,"quality":90,"priority":false,"style":{"maxWidth":"100%","height":"auto","borderRadius":"8px","boxShadow":"0 2px 8px rgba(0,0,0,0.1)"},"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px"}],["$","p",null,{"style":{"fontSize":"0.9em","color":"#666","marginTop":"8px","fontStyle":"italic"},"children":"Airway Seating and screen"}]]}]
16:["$","p","14",{"children":["\nThe Airway closed April 20th, 1966, and the last movie shown at the Airway was “Father Goose,” starring Cary Grant, Leslie Caron, Jennifer Berrington and Stephanie Berrington. They also showed two short films, “What’s Peckin” (a cartoon) and “The Land.”"]}]
17:["$","p","15",{"children":["\nEugene sold the building and land to First Wisconsin National Bank (Now U.S. Bank) for $100,000. Eugene went on to become a shoe sales associate for Gimbels with a regular paycheck. He had a dream and had made it happen with Myles Belongia. This dream brought architectural significance to this area and made a mark in the history of theatre architecture."]}]
18:["$","p","16",{"children":["\nPhoto Credits: https://cinematreasures.org/theaters/2506/photos/410901\n"]}]
19:false
